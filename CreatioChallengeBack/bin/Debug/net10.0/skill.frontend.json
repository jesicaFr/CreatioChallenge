{
  "name": "Creatio Accounts Proxy",
  "version": "1.0",
  "description": "Skill para frontend: lista de cuentas consumiendo la API .NET intermedia que integra con Creatio OData via OAuth2 Client Credentials.",
  "cors": {
    "allowedOriginsConfigKey": "Creatio:AllowedOrigins",
    "note": "El backend ya configura CORS. Frontend debe ejecutar desde origen listado allí."
  },
  "endpoints": [
    {
      "id": "getAccounts",
      "name": "Listar cuentas paginadas",
      "method": "GET",
      "url": "/api/accounts",
      "queryParameters": [
        { "name": "search", "type": "string", "required": false, "description": "Término de búsqueda por Name (server-side, optional)" },
        { "name": "page", "type": "int", "required": false, "default": 1, "description": "Índice de página (1-based)" },
        { "name": "pageSize", "type": "int", "required": false, "default": 5, "description": "Tamaño de página" }
      ],
      "headers": [],
      "security": {
        "handledByBackend": true,
        "note": "El frontend NO debe enviar tokens de Creatio. El backend gestiona OAuth2 y agrega Authorization al llamar Creatio."
      },
      "response": {
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "page": { "type": "integer" },
            "pageSize": { "type": "integer" },
            "total": { "type": "integer" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "code": { "type": "string" },
                  "typeName": { "type": "string" }
                }
              }
            }
          }
        },
        "example": {
          "page": 1,
          "pageSize": 5,
          "total": 1,
          "items": [ { "id": "e308b781-3c5b-4ecb-89ef-5c1ed4da488e", "name": "Our company", "code": "43", "typeName": "Customer" } ]
        }
      },
      "notes": "El endpoint expone solo los campos requeridos y resuelve el lookup Type.Name. Maneja errores HTTP que el frontend debe mostrar (401,403,429,5xx)."
    }
    ,
    {
      "id": "createAccount",
      "name": "Crear cuenta",
      "method": "POST",
      "url": "/api/accounts",
      "body": {
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "Name": { "type": "string" },
            "Code": { "type": "string" },
            "Phone": { "type": "string" },
            "Web": { "type": "string" },
            "TypeId": { "type": "string", "description": "GUID del tipo de cuenta (lookup)" }
          },
          "required": [ "Name", "Code", "TypeId" ]
        },
        "example": {
          "Name": "Empresa Cliente S.A.",
          "Code": "CLI-2026-001",
          "Phone": "+54 11 1234-5678",
          "Web": "https://www.empresacliente.com",
          "TypeId": "57412fad-53e6-df11-971b-001d60e938c6"
        }
      },
      "headers": [],
      "security": {
        "handledByBackend": true,
        "note": "El frontend envía los datos al backend; el backend aplicará OAuth2 y realizará POST a Creatio OData. No enviar tokens de Creatio desde el frontend."
      },
      "response": {
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "status": { "type": "string" }
          }
        },
        "example": { "id": "<new-account-id>", "status": "created" }
      },
      "notes": "El backend debe validar la entrada, mapear al modelo OData esperado y devolver el id creado o el error apropiado."
    }
  ],
  "health": {
    "url": "/health",
    "description": "Endpoint para verificar que el backend está operativo"
  },
  "usageExample": {
    "curl": "curl -s \"https://localhost:<PUERTO>/api/accounts?search=Our&page=1&pageSize=5\"",
    "angularServiceSnippet": "fetchAccounts(search, page = 1, pageSize = 5) { return this.http.get(`/api/accounts?search=${encodeURIComponent(search ?? '')}&page=${page}&pageSize=${pageSize}`); }"
  }
}
